diff --git a/app/src/main/java/com/mytvb/feature/player/VideoPlayerCdnFailoverDataSource.kt b/app/src/main/java/com/mytvb/feature/player/VideoPlayerCdnFailoverDataSource.kt
--- a/app/src/main/java/com/mytvb/feature/player/VideoPlayerCdnFailoverDataSource.kt
+++ b/app/src/main/java/com/mytvb/feature/player/VideoPlayerCdnFailoverDataSource.kt
@@ -31,6 +31,35 @@ internal class VideoPlayerCdnFailoverState(
         CdnLatencyProfile.recordTtfb(url, PENALTY_TTFB_MS)
     }
 
+    /**
+     * 快速二次 BUFFERING：降权当前 host，并把本次会话的 native failover preferredIndex
+     * 移到下一个不同 host。真正的线路重开仍由 VideoPlayerCdnFailoverDataSource.open() 完成。
+     */
+    @Synchronized
+    fun penalizeCurrentHostAndPreferNext(): Boolean {
+        val currentIndex = preferredIndex()
+        val currentUri = candidates.getOrNull(currentIndex) ?: return false
+        CdnLatencyProfile.recordTtfb(currentUri.toString(), PENALTY_TTFB_MS)
+        if (candidates.size <= 1) {
+            return false
+        }
+
+        val currentHost = currentUri.host.orEmpty()
+        val nextIndex = (1 until candidates.size)
+            .map { offset -> (currentIndex + offset) % candidates.size }
+            .firstOrNull { index ->
+                candidates[index].host.orEmpty() != currentHost
+            }
+            ?: return false
+
+        preferredIndex = nextIndex
+        AppLog.w(
+            "PlaybackCdn",
+            "rapid_rebuffer cdn_deprioritized from=$currentHost to=${candidates[nextIndex].host.orEmpty()}"
+        )
+        return true
+    }
+
     companion object {
         // 远大于正常 TTFB(~200ms)，足以把卡顿过的 host 排到 candidates 末尾。
         private const val PENALTY_TTFB_MS = 10_000L
